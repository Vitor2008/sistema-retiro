# Conexão com o Postgres (Neon). NÃO comitar o .env real.
# Monte a URL a partir das credenciais do painel da Neon:
DATABASE_URL="postgres://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Porta do servidor de API
PORT=3001

# Origem permitida no CORS (frontend Vite em dev)
CORS_ORIGIN="http://localhost:5173"

# Autenticação (troque o segredo e as credenciais do admin)
JWT_SECRET="um-segredo-longo-e-aleatorio"
ADMIN_USERNAME="adm"
ADMIN_PASSWORD="defina-uma-senha-forte"
